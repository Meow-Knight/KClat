{
  "name": "klat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@8.13.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:hook": "cargo build -p klat-hook --release && node scripts/stage-sidecar.mjs",
    "release": "tauri build --config src-tauri/tauri.release.conf.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust": "cargo test --workspace"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "20",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
