{
  "name": "klat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:hook": "node scripts/stage-sidecar.mjs",
    "release": "tauri build --config src-tauri/tauri.release.conf.json && node scripts/checksums.mjs",
    "release:mac": "node scripts/stage-sidecar.mjs --target universal-apple-darwin && tauri build --target universal-apple-darwin --config src-tauri/tauri.release.conf.json && node scripts/checksums.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust": "cargo test --workspace",
    "check": "node scripts/check.mjs",
    "check:mac": "node scripts/check-macos.mjs",
    "measure": "node scripts/measure.mjs",
    "regress": "node scripts/regress.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "20",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
