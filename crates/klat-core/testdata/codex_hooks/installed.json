{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd codex-hook SessionStart",
            "statusMessage": "Loading Beads context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bd codex-hook UserPromptSubmit",
            "statusMessage": "Refreshing Beads context",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Klat\\klat-hook.exe\" --agent codex UserPromptSubmit",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/notify.py",
            "commandWindows": "py %USERPROFILE%\\.codex\\hooks\\notify.py",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Klat\\klat-hook.exe\" --agent codex Stop",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/pre_tool_use_policy.py",
            "statusMessage": "Checking Bash command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Klat\\klat-hook.exe\" --agent codex PermissionRequest",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Klat\\klat-hook.exe\" --agent codex PostToolUse",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Klat\\klat-hook.exe\" --agent codex SessionEnd",
            "timeout": 2
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:\\Program Files\\Klat\\klat-hook.exe\" --agent codex Interrupt",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
